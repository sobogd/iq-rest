# =====================================================================
# iq-rest monorepo — unified local .env (single source of truth)
# Generated by scripts/gen-env.mjs into per-app .env files at dev start.
# Copy to .env and fill secrets. Local development only (localhost wiring, no iq-rest.com).
# =====================================================================

NODE_ENV=development

# ---------- Ports (single source of truth) ----------
LANDING_PORT=8001
DASHBOARD_WEB_PORT=8002
DASHBOARD_API_PORT=8003
PUBLIC_MENU_API_PORT=8004
PUBLIC_MENU_PORT=8005

# ---------- Local base URLs (derived from ports) ----------
LANDING_URL=http://localhost:8001
DASHBOARD_URL=http://localhost:8002
DASHBOARD_API_URL=http://localhost:8003
PUBLIC_MENU_API_URL=http://localhost:8004
PUBLIC_MENU_URL=http://localhost:8005

# ---------- Non-secret constants ----------
ADMIN_EMAIL_DOMAIN=iq-rest.com
COOKIE_NAME=iqr_session
COOKIE_SECURE=false
JWT_EXPIRES_IN=7d
VITE_OPTIONS_ENABLED=TRUE

# ---------- Database ----------
DATABASE_URL=
# ---------- Auth / JWT ----------
JWT_SECRET=
# ---------- SMTP / mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
TO_EMAIL=
# ---------- S3 ----------
S3_HOST=
S3_KEY=
S3_TOKEN=
S3_NAME=
S3_REGION=
# ---------- AI / Stripe ----------
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---------- Google Ads ----------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID_VIEWS=
GOOGLE_ADS_CONVERSION_ACTION_ID_CHECKOUT=
GOOGLE_ADS_CONVERSION_ACTION_ID_SUBSCRIPTION=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# ---------- Facebook / Meta ----------
FB_ADS_TOKEN=
FB_ADS_PIXEL_ID=
META_DEVELOPER_TOKEN=
META_APP_SECRET=
# ---------- WhatsApp ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=
# ---------- Misc keys ----------
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
