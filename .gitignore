# dependencies
node_modules/
apps/*/node_modules/

# env (secrets) — never commit
.env
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local

# build output
apps/*/dist/
apps/*/.next/
apps/*/build/
apps/*/.turbo/
.turbo/

# pnpm
# (lockfile pnpm-lock.yaml IS committed; node_modules already ignored above)

# vite / next caches
apps/*/.vite/
apps/*/node_modules/.vite/

# prisma generated client (regenerated on install)
apps/*/node_modules/.prisma/

# logs
*.log
.pm2/

# os
.DS_Store

# packages/db generated prisma client
packages/*/generated/

# Local env backups and Playwright artefacts must never be committed —
# they carry DATABASE_URL and live session cookies.
*.env.bak*
.env.bak*
e2e/node_modules/
e2e/.auth/
e2e/playwright-report/
e2e/test-results/
.claude/worktrees/
